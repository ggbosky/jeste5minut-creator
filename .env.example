# Složka pro databázi, audio, rendery a pózy (výchozí ./data)
DATA_DIR=./data

# Šifrovací tajemství pro uložené API klíče (min. 16 znaků).
# Když chybí, vygeneruje se data/secret.key — pak ho zálohuj spolu s databází.
APP_SECRET=

# Volitelné: klíče z prostředí (používají se, když v Nastavení → API klíče není žádný aktivní)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Za HTTPS proxy nastav 1, aby se session cookie posílala jen přes HTTPS
COOKIE_SECURE=
